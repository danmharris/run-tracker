<% content_for(:head) do %>
<link rel='stylesheet' href='https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css' />
<script src='https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js'></script>
<style nonce="<%= @nonce %>">
  #map { height: 500px; width: 500px; }
</style>
<% end %>

<ul>
  <li>Distance (km): <%= @distance %></li>
  <li>Time (min): <%= @time %></li>
  <li>Average pace (min/km): <%= @time / @distance %></li>
</ul>

<div id="map"></div>
<script nonce="<%= @nonce %>">
  const geojson = <%= @geojson %>
  const start = <%= @start %>
  const map = new maplibregl.Map({
        container: 'map',
        style: 'https://tiles.openfreemap.org/styles/bright',
        center: start,
        zoom: 15
    });

    map.on('load', () => {
        map.addSource('route', {
            'type': 'geojson',
            'data': geojson
        });
        map.addLayer({
            'id': 'route',
            'type': 'line',
            'source': 'route',
            'layout': {
                'line-join': 'round',
                'line-cap': 'round'
            },
            'paint': {
                'line-color': '#888',
                'line-width': 8
            }
        });
    });
</script>
