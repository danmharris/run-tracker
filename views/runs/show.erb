<a href="<%= relative_path('/runs') %>">Back</a>
<h1><%= @time.strftime('%a %d %b @ %H:%M') %></h1>

<div class="stats">
  <div class="stat">
    <h2>DIST</h2>
    <div class="value">
      <span><%= format('%.2f', @distance) %><span>
      <span class="unit">km</span>
    </div>
  </div>
  <div class="stat">
    <h2>TIME</h2>
    <div class="value">
      <span><%= format_seconds(@duration) %><span>
      <span class="unit">min</span>
    </div>
  </div>
  <div class="stat">
    <h2>PACE</h2>
    <div class="value">
      <span><%= format_seconds(@duration / @distance) %><span>
      <span class="unit">min/km</span>
    </div>
  </div>
</div>

<div id="map" 
  data-geojson-url="<%= @geojson_url %>"
  data-min-lon="<%= @bounds.min_lon %>"
  data-max-lon="<%= @bounds.max_lon %>"
  data-min-lat="<%= @bounds.min_lat %>"
  data-max-lat="<%= @bounds.max_lat %>"
>
</div>
