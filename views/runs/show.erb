<ul>
  <li>Distance (km): <%= format('%.2f', @distance) %></li>
  <li>Time (min): <%= format_seconds(@time) %></li>
  <li>Average pace (min/km): <%= format_seconds(@time / @distance) %></li>
</ul>

<div id="map" 
  data-geojson-url="<%= @geojson_url %>"
  data-min-lon="<%= @bounds.min_lon %>"
  data-max-lon="<%= @bounds.max_lon %>"
  data-min-lat="<%= @bounds.min_lat %>"
  data-max-lat="<%= @bounds.max_lat %>"
>
</div>
